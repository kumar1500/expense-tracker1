* {
  box-sizing: border-box;
}
body {
  margin: 0;
  font-family: Inter, Arial, sans-serif;
  background: #f5f7fb;
  color: #18202f;
}
.app {
  display: flex;
  min-height: 100vh;
}
.sidebar {
  width: 245px;
  background: #111827;
  color: white;
  padding: 28px 18px;
  position: fixed;
  inset: 0 auto 0 0;
}
.sidebar h2 {
  margin: 0 10px 35px;
  font-size: 21px;
}
.sidebar h2 span {
  color: #60a5fa;
}
.sidebar nav {
  display: grid;
  gap: 8px;
}
.sidebar nav a {
  color: #cbd5e1;
  text-decoration: none;
  padding: 13px 14px;
  border-radius: 10px;
}
.sidebar nav a:hover,
.sidebar nav a.active {
  background: #1e293b;
  color: white;
}
.side-note {
  position: absolute;
  bottom: 30px;
  left: 30px;
  color: #64748b;
  font-size: 13px;
}
.main {
  margin-left: 245px;
  width: calc(100% - 245px);
  padding: 30px;
  max-width: 1500px;
}
.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 25px;
}
.eyebrow {
  font-size: 11px;
  letter-spacing: 2px;
  color: #64748b;
  margin: 0 0 5px;
}
.topbar h1 {
  margin: 0;
  font-size: 30px;
}
.primary,
.secondary {
  border: 0;
  border-radius: 9px;
  padding: 11px 17px;
  font-weight: 700;
  cursor: pointer;
}
.primary {
  background: #2563eb;
  color: #fff;
}
.primary:hover {
  background: #1d4ed8;
}
.secondary {
  background: #e5e7eb;
  color: #374151;
}
.cards {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  margin-bottom: 18px;
}
.card,
.panel {
  background: #fff;
  border: 1px solid #e5e7eb;
  border-radius: 15px;
  box-shadow: 0 4px 18px #0f172a08;
}
.card {
  padding: 20px;
}
.card span {
  font-size: 13px;
  color: #64748b;
}
.card strong {
  display: block;
  font-size: 25px;
  margin-top: 9px;
}
.income strong {
  color: #16a34a;
}
.expense strong {
  color: #dc2626;
}
.balance strong {
  color: #2563eb;
}
.grid {
  display: grid;
  grid-template-columns: 1.6fr 1fr;
  gap: 18px;
  margin-bottom: 18px;
}
.panel {
  padding: 20px;
  margin-bottom: 18px;
}
.panel-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15px;
}
.panel-head h2 {
  font-size: 18px;
  margin: 0;
}
.muted,
.panel-head span {
  color: #64748b;
  font-size: 13px;
  margin: 5px 0 0;
}
.category-list {
  display: grid;
  gap: 13px;
}
.cat-row {
  display: grid;
  grid-template-columns: 100px 1fr 70px;
  gap: 10px;
  align-items: center;
  font-size: 13px;
}
.bar {
  height: 8px;
  background: #e5e7eb;
  border-radius: 10px;
  overflow: hidden;
}
.bar i {
  display: block;
  height: 100%;
  background: #2563eb;
  border-radius: 10px;
}
.filters {
  display: flex;
  gap: 8px;
}
.filters input,
.filters select,
label input,
label select {
  border: 1px solid #dbe0e8;
  border-radius: 8px;
  padding: 10px;
  background: #fff;
  color: #111827;
}
.wrap {
  align-items: flex-end;
}
.table-wrap {
  overflow: auto;
}
table {
  width: 100%;
  border-collapse: collapse;
  min-width: 760px;
}
th,
td {
  text-align: left;
  padding: 13px 10px;
  border-bottom: 1px solid #eef0f4;
  font-size: 13px;
}
th {
  color: #64748b;
  font-weight: 600;
}
.tag {
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 700;
}
.tag.income {
  background: #dcfce7;
  color: #15803d;
}
.tag.expense {
  background: #fee2e2;
  color: #b91c1c;
}
.amount.income {
  color: #16a34a;
  font-weight: 700;
}
.amount.expense {
  color: #dc2626;
  font-weight: 700;
}
.actions button {
  border: 0;
  background: transparent;
  cursor: pointer;
  font-size: 16px;
  margin-right: 5px;
}
.empty {
  text-align: center;
  color: #94a3b8;
  padding: 35px;
}
.form-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16px;
}
label {
  font-size: 13px;
  font-weight: 600;
  display: grid;
  gap: 7px;
}
label input,
label select {
  font-size: 14px;
  font-weight: 400;
}
.wide {
  grid-column: 1/-1;
}
.form-actions {
  display: flex;
  gap: 9px;
  margin-top: 18px;
}
canvas {
  width: 100%;
  max-height: 260px;
}
.hidden {
  display: none;
}
@media (max-width: 900px) {
  .sidebar {
    width: 190px;
  }
  .main {
    margin-left: 190px;
    width: calc(100% - 190px);
    padding: 20px;
  }
  .cards {
    grid-template-columns: repeat(2, 1fr);
  }
  .grid {
    grid-template-columns: 1fr;
  }
}
@media (max-width: 600px) {
  .sidebar {
    position: static;
    width: 100%;
    height: auto;
  }
  .sidebar nav {
    display: flex;
    overflow: auto;
  }
  .sidebar .side-note {
    display: none;
  }
  .app {
    display: block;
  }
  .main {
    margin: 0;
    width: 100%;
    padding: 15px;
  }
  .topbar {
    gap: 10px;
  }
  .topbar h1 {
    font-size: 24px;
  }
  .cards {
    grid-template-columns: 1fr 1fr;
  }
  .grid {
    display: block;
  }
  .filters {
    width: 100%;
  }
  .filters input {
    width: 100%;
  }
  .form-grid {
    grid-template-columns: 1fr;
  }
  .wide {
    grid-column: auto;
  }
  .wrap {
    display: block;
  }
  .wrap .filters {
    margin-top: 12px;
  }
  .card strong {
    font-size: 19px;
  }
}