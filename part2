const KEY = "expenseTrackerData";
let transactions = JSON.parse(localStorage.getItem(KEY) || "[]");
const $ = (id) => document.getElementById(id);
const money = (n) =>
  "â‚¹" +
  Number(n).toLocaleString("en-IN", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

function save() {
  localStorage.setItem(KEY, JSON.stringify(transactions));
}
function today() {
  return new Date().toISOString().slice(0, 10);
}
function resetForm() {
  $("transactionForm").reset();
  $("editId").value = "";
  $("date").value = today();
  $("type").value = "expense";
  $("saveBtn").textContent = "Save Transaction";
}
function openForm() {
  document.querySelector("#add").scrollIntoView({ behavior: "smooth" });
  $("description").focus();
}
function editTx(id) {
  const t = transactions.find((x) => x.id === id);
  if (!t) return;
  $("editId").value = t.id;
  $("type").value = t.type;
  $("amount").value = t.amount;
  $("category").value = t.category;
  $("date").value = t.date;
  $("description").value = t.description;
  $("saveBtn").textContent = "Update Transaction";
  openForm();
}
function deleteTx(id) {
  if (confirm("Delete this transaction?")) {
    transactions = transactions.filter((x) => x.id !== id);
    save();
    render();
  }
}
$("transactionForm").addEventListener("submit", (e) => {
  e.preventDefault();
  const id = $("editId").value;
  const item = {
    id: id || Date.now().toString(),
    type: $("type").value,
    amount: +$("amount").value,
    category: $("category").value,
    date: $("date").value,
    description: $("description").value.trim(),
  };
  if (id) transactions = transactions.map((t) => (t.id === id ? item : t));
  else transactions.unshift(item);
  save();
  render();
  resetForm();
});
$("search").addEventListener("input", renderTable);
$("filter").addEventListener("change", renderTable);

function render() {
  const income = transactions
    .filter((t) => t.type === "income")
    .reduce((s, t) => s + t.amount, 0);
  const expense = transactions
    .filter((t) => t.type === "expense")
    .reduce((s, t) => s + t.amount, 0);
  $("income").textContent = money(income);
  $("expense").textContent = money(expense);
  $("balance").textContent = money(income - expense);
  $("count").textContent = transactions.length;
  $("monthLabel").textContent = new Date().toLocaleDateString("en-IN", {
    month: "long",
    year: "numeric",
  });
  renderTable();
  renderCategories();
  drawChart();
}
function renderTable() {
  const q = $("search").value.toLowerCase(),
    f = $("filter").value;
  const data = transactions
    .filter(
      (t) =>
        (f === "all" || t.type === f) &&
        `${t.description} ${t.category}`.toLowerCase().includes(q)
    )
    .sort((a, b) => b.date.localeCompare(a.date));
  $("transactionBody").innerHTML = data
    .map(
      (t) => `<tr> <td>${new Date(t.date + "T00:00:00").toLocaleDateString("en-IN")}</td> <td>${escapeHtml(t.description)}</td><td>${escapeHtml(t.category)}</td> <td><span class="tag ${t.type}">${t.type}</span></td> <td class="amount ${t.type}">${t.type === "income" ? "+" : "-"} ${money( t.amount )}</td> <td class="actions"><button onclick="editTx('${ t.id }')">âœï¸</button><button onclick="deleteTx('${t.id}')">ðŸ—‘ï¸</button></td> </tr>`
    )
    .join("");
  $("empty").style.display = data.length ? "none" : "block";
}
function escapeHtml(s) {
  return s.replace(
    /[&<>"']/g,
    (m) =>
      ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#039;" }[
        m
      ])
  );
}
function renderCategories() {
  const sums = {};
  transactions
    .filter((t) => t.type === "expense")
    .forEach((t) => (sums[t.category] = (sums[t.category] || 0) + t.amount));
  const rows = Object.entries(sums).sort((a, b) => b[1] - a[1]);
  const max = rows[0]?.[1] || 1;
  $("categoryList").innerHTML = rows.length
    ? rows
        .map(
          ([c, v]) =>
            `<div class="cat-row"><b>${escapeHtml( c )}</b><div class="bar"><i style="width:${ (v / max) * 100 }%"></i></div><span>${money(v)}</span></div>`
        )
        .join("")
    : "<p class='muted'>No expense data yet.</p>";
}
function drawChart() {
  const canvas = $("expenseChart"),
    ctx = canvas.getContext("2d"),
    dpr = devicePixelRatio || 1,
    w = canvas.clientWidth,
    h = 260;
  canvas.width = w * dpr;
  canvas.height = h * dpr;
  ctx.scale(dpr, dpr);
  ctx.clearRect(0, 0, w, h);
  const days = Array.from({ length: 7 }, (_, i) => {
    const d = new Date();
    d.setDate(d.getDate() - (6 - i));
    return d;
  });
  const vals = days.map((d) =>
    transactions
      .filter(
        (t) => t.type === "expense" && t.date === d.toISOString().slice(0, 10)
      )
      .reduce((s, t) => s + t.amount, 0)
  );
  const max = Math.max(...vals, 100),
    pad = 35,
    bottom = 35,
    chartH = h - pad - bottom,
    chartW = w - pad * 2;
  ctx.strokeStyle = "#e5e7eb";
  ctx.lineWidth = 1;
  for (let i = 0; i < 5; i++) {
    let y = pad + (i * chartH) / 4;
    ctx.beginPath();
    ctx.moveTo(pad, y);
    ctx.lineTo(w - pad, y);
    ctx.stroke();
  }
  ctx.beginPath();
  vals.forEach((v, i) => {
    const x = pad + (i * chartW) / 6,
      y = pad + chartH - (v / max) * chartH;
    i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
  });
  ctx.strokeStyle = "#2563eb";
  ctx.lineWidth = 3;
  ctx.stroke();
  vals.forEach((v, i) => {
    const x = pad + (i * chartW) / 6,
      y = pad + chartH - (v / max) * chartH;
    ctx.fillStyle = "#2563eb";
    ctx.beginPath();
    ctx.arc(x, y, 4, 0, Math.PI * 2);
    ctx.fill();
    ctx.fillStyle = "#64748b";
    ctx.font = "11px Arial";
    ctx.textAlign = "center";
    ctx.fillText(
      days[i].toLocaleDateString("en-IN", { weekday: "short" }),
      x,
      h - 12
    );
  });
}
$("date").value = today();
render();
window.addEventListener("resize", drawChart);