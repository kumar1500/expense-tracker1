<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Expense Tracker</title>
  <link rel="stylesheet" href="style.css">
</head>
<body>
  <div class="app">
    <aside class="sidebar">
      <h2>💰 Expense<span>Tracker</span></h2>
      <nav>
        <a class="active" href="#dashboard">Dashboard</a>
        <a href="#transactions">Transactions</a>
        <a href="#add">Add Transaction</a>
      </nav>
      <div class="side-note">Your money, organized.</div>
    </aside>

    <main class="main">
      <header class="topbar">
        <div>
          <p class="eyebrow">PERSONAL FINANCE</p>
          <h1>Dashboard</h1>
        </div>
        <button class="primary" onclick="openForm()">+ Add Transaction</button>
      </header>

      <section id="dashboard" class="cards">
        <div class="card income"><span>💵 Total Income</span><strong id="income">₹0.00</strong></div>
        <div class="card expense"><span>💸 Total Expense</span><strong id="expense">₹0.00</strong></div>
        <div class="card balance"><span>💰 Balance</span><strong id="balance">₹0.00</strong></div>
        <div class="card count"><span>🧾 Transactions</span><strong id="count">0</strong></div>
      </section>

      <section class="grid">
        <div class="panel chart-panel">
          <div class="panel-head"><h2>Expense Overview</h2><span id="monthLabel"></span></div>
          <canvas id="expenseChart" width="500" height="260"></canvas>
        </div>

        <div class="panel">
          <div class="panel-head"><h2>Categories</h2></div>
          <div id="categoryList" class="category-list"></div>
        </div>
      </section>

      <section id="transactions" class="panel">
        <div class="panel-head wrap">
          <div><h2>Recent Transactions</h2><p class="muted">Manage your income and expenses</p></div>
          <div class="filters">
            <input id="search" type="search" placeholder="Search...">
            <select id="filter">
              <option value="all">All</option>
              <option value="income">Income</option>
              <option value="expense">Expense</option>
            </select>
          </div>
        </div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Date</th><th>Description</th><th>Category</th><th>Type</th><th>Amount</th><th>Action</th></tr></thead>
            <tbody id="transactionBody"></tbody>
          </table>
          <div id="empty" class="empty">No transactions yet. Add your first transaction.</div>
        </div>
      </section>

      <section id="add" class="panel form-panel">
        <div class="panel-head"><h2>Add Transaction</h2></div>
        <form id="transactionForm">
          <input type="hidden" id="editId">
          <div class="form-grid">
            <label>Type
              <select id="type" required><option value="expense">Expense</option><option value="income">Income</option></select>
            </label>
            <label>Amount (₹)<input id="amount" type="number" min="0.01" step="0.01" required></label>
            <label>Category
              <select id="category" required>
                <option>Food</option><option>Travel</option><option>Shopping</option><option>Bills</option>
                <option>Education</option><option>Health</option><option>Salary</option><option>Other</option>
              </select>
            </label>
            <label>Date<input id="date" type="date" required></label>
            <label class="wide">Description<input id="description" type="text" maxlength="80" placeholder="e.g. Grocery shopping" required></label>
          </div>
          <div class="form-actions">
            <button class="primary" type="submit" id="saveBtn">Save Transaction</button>
            <button class="secondary" type="button" onclick="resetForm()">Clear</button>
          </div>
        </form>
      </section>
    </main>
  </div>
  <script src="script.js"></script>
</body>
</html>